{
  "schema": "warband.agentic/subprocess-adapters/v1",
  "adapters": [
    {
      "provider": "opencode-v2",
      "argv": [
        "/absolute/path/to/warband-provider-opencode",
        "--executable",
        "/absolute/path/to/shuvcode",
        "--assignment-provider",
        "opencode-v2",
        "--dialect",
        "v2"
      ],
      "pass_environment": [
        "HOME",
        "PATH"
      ]
    },
    {
      "provider": "cursor",
      "argv": [
        "/absolute/path/to/cursor-warband-wrapper"
      ],
      "pass_environment": [
        "CURSOR_API_KEY"
      ]
    }
  ]
}
